#pragma once

// Generato da CMake (configure_file) in build/generated/Version.h: non modificare quello.
// La versione si cambia in CMakeLists.txt: project(Vaultly VERSION x.y.z).

#define VAULTLY_VERSION "@PROJECT_VERSION@"

// Da dove l'app scarica le informazioni sugli aggiornamenti (vuoto = aggiornamenti disattivati).
#define VAULTLY_UPDATE_FEED_URL "@VAULTLY_UPDATE_FEED_URL@"

// Chiave pubblica EdDSA: un aggiornamento viene installato solo se è firmato con la chiave
// privata corrispondente (che sta fuori dal repository, vedi scripts/release.ps1).
#define VAULTLY_UPDATE_PUBLIC_KEY "@VAULTLY_UPDATE_PUBLIC_KEY@"
